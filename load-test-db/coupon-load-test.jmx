      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="시나리오5: 사용자별 중복 요청 (1명이 10번 요청)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
