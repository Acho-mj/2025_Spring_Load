                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
        </hashTree>
      </hashTree>
      <!-- 시나리오 3: 같은 쿠폰에 여러 명이 동시에 요청 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="시나리오3: 동시성 테스트 (1개 재고, 100명 동시)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
