      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="시나리오4: 쿠폰 소진 후 (0개 재고, 1000명 요청)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
